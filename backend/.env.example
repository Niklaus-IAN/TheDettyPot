# Copy to .env for local development: cp .env.example .env
APP_ENV=local
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
# Docker Postgres (npm run db:up). Using your own Postgres instead? Point both URLs at it.
DATABASE_URL=postgres://dettypot:dettypot@localhost:5433/dettypot
TEST_DATABASE_URL=postgres://dettypot:dettypot@localhost:5433/dettypot_test
# Serve the interactive API docs at /docs (keep off in production)
ENABLE_DOCS=true
# Sign-in. Locally, `npm run dev:token -- you@example.com` creates a signing key
# and prints a token to paste into the docs page's Authorize button.
# In AWS these point at the real identity provider and AUTH_DEV_JWKS_FILE is unset.
AUTH_ISSUER=https://auth.dettypot.local
AUTH_AUDIENCE=dettypot-api
AUTH_DEV_JWKS_FILE=.dev-auth/jwks.json
